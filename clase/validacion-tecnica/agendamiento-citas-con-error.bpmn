<?xml version="1.0" encoding="UTF-8"?>
<!-- Variante del proceso de agendamiento CON UN ERROR A PROPÓSITO, para practicar la validación.
     Las dos salidas de una compuerta exclusiva (X) se vuelven a unir con una compuerta
     paralela (+). La compuerta paralela espera un token por cada entrada, pero la exclusiva
     solo envía uno: el proceso se queda bloqueado y nunca llega al evento de fin. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definiciones_Agendamiento_Error"
                  targetNamespace="https://github.com/CesarAVegaF312/AREM-Taller_1_BPMN">
  <bpmn:collaboration id="Colaboracion_Agendamiento_Error">
    <bpmn:participant id="Pool_Agendamiento" name="Agendamiento de Citas Médicas (con error)" processRef="Proceso_Agendamiento_Error" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Agendamiento_Error" name="Agendamiento de Citas Médicas (con error)" isExecutable="true">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_Paciente" name="Paciente">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seleccionar_Especialidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_Sistema" name="Sistema de Citas">
        <bpmn:flowNodeRef>Consultar_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hay_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmar_Cita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Informar_Sin_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unir_Resultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Solicitud_Atendida</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Paciente decide agendar cita">
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Seleccionar_Especialidad" name="Seleccionar Especialidad y Médico">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Consultar_Disponibilidad" name="Consultar Disponibilidad">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Hay_Disponibilidad" name="¿Hay disponibilidad?" default="Flujo_No">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_Si</bpmn:outgoing>
      <bpmn:outgoing>Flujo_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Confirmar_Cita" name="Confirmar Cita y Notificar al Paciente">
      <bpmn:incoming>Flujo_Si</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Informar_Sin_Disponibilidad" name="Informar que no hay Disponibilidad">
      <bpmn:incoming>Flujo_No</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Unir_Resultados" name="Error: unión paralela">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Registrar_Resultado" name="Registrar Resultado de la Solicitud">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin_Solicitud_Atendida" name="Solicitud Atendida">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="Inicio" targetRef="Seleccionar_Especialidad" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="Seleccionar_Especialidad" targetRef="Consultar_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="Consultar_Disponibilidad" targetRef="Hay_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_Si" name="Sí" sourceRef="Hay_Disponibilidad" targetRef="Confirmar_Cita">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disponible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_No" name="No" sourceRef="Hay_Disponibilidad" targetRef="Informar_Sin_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="Confirmar_Cita" targetRef="Unir_Resultados" />
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="Informar_Sin_Disponibilidad" targetRef="Unir_Resultados" />
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="Unir_Resultados" targetRef="Registrar_Resultado" />
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="Registrar_Resultado" targetRef="Fin_Solicitud_Atendida" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Agendamiento_Error">
    <bpmndi:BPMNPlane id="Plano_Agendamiento_Error" bpmnElement="Colaboracion_Agendamiento_Error">
      <bpmndi:BPMNShape id="Pool_Agendamiento_di" bpmnElement="Pool_Agendamiento" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1200" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Paciente_di" bpmnElement="Carril_Paciente" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1170" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Sistema_di" bpmnElement="Carril_Sistema" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1170" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio">
        <dc:Bounds x="222" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Seleccionar_Especialidad_di" bpmnElement="Seleccionar_Especialidad">
        <dc:Bounds x="300" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Consultar_Disponibilidad_di" bpmnElement="Consultar_Disponibilidad">
        <dc:Bounds x="500" y="365" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hay_Disponibilidad_di" bpmnElement="Hay_Disponibilidad" isMarkerVisible="true">
        <dc:Bounds x="695" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="435" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirmar_Cita_di" bpmnElement="Confirmar_Cita">
        <dc:Bounds x="800" y="300" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Informar_Sin_Disponibilidad_di" bpmnElement="Informar_Sin_Disponibilidad">
        <dc:Bounds x="800" y="430" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Unir_Resultados_di" bpmnElement="Unir_Resultados">
        <dc:Bounds x="995" y="380" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="352" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Registrar_Resultado_di" bpmnElement="Registrar_Resultado">
        <dc:Bounds x="1090" y="365" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_Solicitud_Atendida_di" bpmnElement="Fin_Solicitud_Atendida">
        <dc:Bounds x="1282" y="387" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1">
        <di:waypoint x="258" y="180" />
        <di:waypoint x="300" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2">
        <di:waypoint x="440" y="180" />
        <di:waypoint x="570" y="180" />
        <di:waypoint x="570" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3">
        <di:waypoint x="640" y="405" />
        <di:waypoint x="695" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_Si_di" bpmnElement="Flujo_Si">
        <di:waypoint x="720" y="380" />
        <di:waypoint x="720" y="340" />
        <di:waypoint x="800" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_No_di" bpmnElement="Flujo_No">
        <di:waypoint x="720" y="430" />
        <di:waypoint x="720" y="470" />
        <di:waypoint x="800" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="728" y="445" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4">
        <di:waypoint x="940" y="340" />
        <di:waypoint x="1020" y="340" />
        <di:waypoint x="1020" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5">
        <di:waypoint x="940" y="470" />
        <di:waypoint x="1020" y="470" />
        <di:waypoint x="1020" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6">
        <di:waypoint x="1045" y="405" />
        <di:waypoint x="1090" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7">
        <di:waypoint x="1230" y="405" />
        <di:waypoint x="1282" y="405" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
