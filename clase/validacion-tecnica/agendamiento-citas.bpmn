<?xml version="1.0" encoding="UTF-8"?>
<!-- Proceso de agendamiento de citas de la Fundación Salud Viva (caso base del Taller 1).
     Es el mismo modelo de clase/ejemplo-agendamiento-citas.drawio, en formato BPMN 2.0,
     para abrirlo en un simulador de tokens y validar que todo camino termina. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definiciones_Agendamiento"
                  targetNamespace="https://github.com/CesarAVegaF312/AREM-Taller_1_BPMN">
  <bpmn:collaboration id="Colaboracion_Agendamiento">
    <bpmn:participant id="Pool_Agendamiento" name="Agendamiento de Citas Médicas" processRef="Proceso_Agendamiento" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Agendamiento" name="Agendamiento de Citas Médicas" isExecutable="true">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_Paciente" name="Paciente">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seleccionar_Especialidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_Sistema" name="Sistema de Citas">
        <bpmn:flowNodeRef>Consultar_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hay_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmar_Cita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Cita_Confirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_Sin_Disponibilidad</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Paciente decide agendar cita">
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Seleccionar_Especialidad" name="Seleccionar Especialidad y Médico">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Consultar_Disponibilidad" name="Consultar Disponibilidad">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Hay_Disponibilidad" name="¿Hay disponibilidad?" default="Flujo_No">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_Si</bpmn:outgoing>
      <bpmn:outgoing>Flujo_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Confirmar_Cita" name="Confirmar Cita y Notificar al Paciente">
      <bpmn:incoming>Flujo_Si</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin_Cita_Confirmada" name="Cita Confirmada">
      <bpmn:incoming>Flujo_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_Sin_Disponibilidad" name="Sin Disponibilidad">
      <bpmn:incoming>Flujo_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="Inicio" targetRef="Seleccionar_Especialidad" />
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="Seleccionar_Especialidad" targetRef="Consultar_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_3" sourceRef="Consultar_Disponibilidad" targetRef="Hay_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_Si" name="Sí" sourceRef="Hay_Disponibilidad" targetRef="Confirmar_Cita">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">disponible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flujo_No" name="No" sourceRef="Hay_Disponibilidad" targetRef="Fin_Sin_Disponibilidad" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="Confirmar_Cita" targetRef="Fin_Cita_Confirmada" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Agendamiento">
    <bpmndi:BPMNPlane id="Plano_Agendamiento" bpmnElement="Colaboracion_Agendamiento">
      <bpmndi:BPMNShape id="Pool_Agendamiento_di" bpmnElement="Pool_Agendamiento" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="940" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Paciente_di" bpmnElement="Carril_Paciente" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="910" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_Sistema_di" bpmnElement="Carril_Sistema" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="910" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio">
        <dc:Bounds x="222" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Seleccionar_Especialidad_di" bpmnElement="Seleccionar_Especialidad">
        <dc:Bounds x="300" y="140" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Consultar_Disponibilidad_di" bpmnElement="Consultar_Disponibilidad">
        <dc:Bounds x="500" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hay_Disponibilidad_di" bpmnElement="Hay_Disponibilidad" isMarkerVisible="true">
        <dc:Bounds x="695" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="320" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirmar_Cita_di" bpmnElement="Confirmar_Cita">
        <dc:Bounds x="800" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_Cita_Confirmada_di" bpmnElement="Fin_Cita_Confirmada">
        <dc:Bounds x="1012" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_Sin_Disponibilidad_di" bpmnElement="Fin_Sin_Disponibilidad">
        <dc:Bounds x="702" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="443" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1">
        <di:waypoint x="258" y="180" />
        <di:waypoint x="300" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2">
        <di:waypoint x="440" y="180" />
        <di:waypoint x="570" y="180" />
        <di:waypoint x="570" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3">
        <di:waypoint x="640" y="380" />
        <di:waypoint x="695" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_Si_di" bpmnElement="Flujo_Si">
        <di:waypoint x="745" y="380" />
        <di:waypoint x="800" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_No_di" bpmnElement="Flujo_No">
        <di:waypoint x="720" y="405" />
        <di:waypoint x="720" y="432" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="728" y="408" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4">
        <di:waypoint x="940" y="380" />
        <di:waypoint x="1012" y="380" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
