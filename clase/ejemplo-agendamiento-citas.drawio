<mxfile host="app.diagrams.net">
  <diagram name="Agendamiento de Citas Médicas" id="bpmn-agendamiento">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lanePaciente" value="Paciente" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1080" height="180" as="geometry" />
        </mxCell>
        <mxCell id="laneSistema" value="Sistema de Citas" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1080" height="180" as="geometry" />
        </mxCell>

        <!-- Evento de inicio -->
        <mxCell id="start" value="Paciente decide&#10;agendar cita" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="lanePaciente">
          <mxGeometry x="60" y="65" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Tarea: seleccionar especialidad y medico -->
        <mxCell id="t1" value="Seleccionar&#10;Especialidad y Médico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lanePaciente">
          <mxGeometry x="200" y="60" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Tarea: consultar disponibilidad -->
        <mxCell id="t2" value="Consultar&#10;Disponibilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneSistema">
          <mxGeometry x="440" y="60" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Gateway exclusivo -->
        <mxCell id="gw1" value="¿Hay&#10;disponibilidad?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="laneSistema">
          <mxGeometry x="660" y="55" width="100" height="100" as="geometry" />
        </mxCell>

        <!-- Tarea: confirmar cita -->
        <mxCell id="t3" value="Confirmar Cita y&#10;Notificar al Paciente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneSistema">
          <mxGeometry x="840" y="60" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Evento fin: cita confirmada -->
        <mxCell id="end1" value="Cita&#10;Confirmada" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;" vertex="1" parent="lanePaciente">
          <mxGeometry x="1000" y="65" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Evento fin: sin disponibilidad -->
        <mxCell id="end2" value="Sin&#10;Disponibilidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;" vertex="1" parent="laneSistema">
          <mxGeometry x="700" y="150" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- Flujos de secuencia -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="lanePaciente" source="start" target="t1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="laneSistema" source="t2" target="gw1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="laneSistema" source="gw1" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="laneSistema" source="gw1" target="end2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t3" target="end1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
